# MatchFrame environment. `pnpm setup` copies this to .env and replaces every __GENERATE__ value
# with a random development secret. Never reuse development secrets in production.

# --- Branding (configurable; no third-party marks) ---
PRODUCT_NAME=MatchFrame
PRODUCT_SHORT_NAME=Studio
PRODUCT_PRIMARY_COLOR=#3EA6FF
DEFAULT_LOCALE=en-AU
DEFAULT_TIMEZONE=Australia/Brisbane

# --- Public (browser-facing) and internal addresses. Keep them separate. ---
PUBLIC_WEB_URL=http://localhost:3000          # origin users open
PUBLIC_API_URL=http://localhost:3000          # same origin via Next rewrite / reverse proxy
PUBLIC_REALTIME_URL=http://localhost:4000     # Socket.IO endpoint (same origin behind the proxy in production)
PUBLIC_LIVEKIT_URL=ws://localhost:7880        # browsers: input WebRTC preview
PUBLIC_RTMP_URL=rtmp://localhost:1935/live    # shown to encoder operators
INTERNAL_API_URL=http://127.0.0.1:4000        # web server -> API, workers -> API
INTERNAL_RENDER_BASE_URL=http://127.0.0.1:3000 # URL the egress Chrome uses to load /render/programme
INTERNAL_LIVEKIT_HTTP=http://127.0.0.1:7880
INTERNAL_LIVEKIT_WS=ws://127.0.0.1:7880
API_PORT=4000
WEB_PORT=3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL. Admin role runs migrations only; the API uses bs_app (RLS enforced), workers bs_worker. ---
POSTGRES_PORT=5432
POSTGRES_DB=broadcast_studio
POSTGRES_ADMIN_USER=bs_owner
POSTGRES_ADMIN_PASSWORD=__GENERATE__
DATABASE_ADMIN_URL=postgres://bs_owner:${POSTGRES_ADMIN_PASSWORD}@127.0.0.1:5432/broadcast_studio
DB_APP_PASSWORD=__GENERATE__
DATABASE_URL=postgres://bs_app:${DB_APP_PASSWORD}@127.0.0.1:5432/broadcast_studio
DB_WORKER_PASSWORD=__GENERATE__
DATABASE_WORKER_URL=postgres://bs_worker:${DB_WORKER_PASSWORD}@127.0.0.1:5432/broadcast_studio

# --- Redis (BullMQ delivery + realtime fan-out; never the system of record) ---
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0

# --- Auth ---
BETTER_AUTH_SECRET=__GENERATE__
SESSION_MAX_AGE_DAYS=14
# Set to true only for automated tests; logs verification links instead of requiring SMTP delivery.
AUTH_LOG_EMAIL_LINKS=false

# --- SMTP (Mailpit locally) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MatchFrame <no-reply@studio.localhost>"
# the team inbox for the public contact form: every message is stored and listed for site staff (/staff →
# Enquiries); with this set it is also emailed here (reply-to: the sender). With neither an inbox nor any site
# staff, the form says it is not connected.
CONTACT_EMAIL=
MAILPIT_UI_PORT=8025
# site staff: verified accounts with these emails (comma-separated) are Owners of the staff console (/staff)
PLATFORM_OWNER_EMAILS=

# --- Object storage (S3-compatible; MinIO locally). Buckets are private. ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=broadcast-studio
S3_ACCESS_KEY=bsminio
S3_SECRET_KEY=__GENERATE__
S3_FORCE_PATH_STYLE=true

# --- Secrets encryption (stream keys, provider secrets). 32 bytes base64. Deployment-managed in production. ---
ENCRYPTION_KEY=__GENERATE_KEY__
# HMAC key for media playback tokens and renderer bootstrap tokens
MEDIA_TOKEN_SECRET=__GENERATE__

# --- Streaming. false = graphics-only (scoring, overlays for OBS, automation, sponsors, media library);
# LiveKit is then not needed (`pnpm services:up:core`) and stream inputs/outputs/recordings are hidden. ---
STREAMING_ENABLED=true

# --- LiveKit (self-hosted default; managed LiveKit works with the same three values) ---
LIVEKIT_API_KEY=bskey
LIVEKIT_API_SECRET=__GENERATE__
# Non-loopback address of this host for ICE (loopback candidates are rejected). `pnpm setup` detects it.
LIVEKIT_NODE_IP=__DETECT__
LIVEKIT_WEBHOOK_URL=http://127.0.0.1:4000/api/v1/webhooks/media
MEDIA_PROVIDER=livekit                       # livekit | fake (fake only for tests/explicit demo mode)

# --- Capacity & limits (server-enforced; measured values in MEDIA_SPIKE.md) ---
MAX_CONCURRENT_PROGRAMMES=2  # outputs (programme + clean of ONE 720p session) on the 4 vCPU reference box; CPU saturated (load 15-20) — see ACCEPTANCE_RESULTS A51
MAX_DESTINATIONS_PER_OUTPUT=3
ENABLE_1080P_PRESETS=false
INPUT_WAIT_TIMEOUT_SECONDS=120
UPLOAD_MAX_BYTES=524288000
UPLOAD_MAX_IMAGE_PIXELS=25000000
UPLOAD_MAX_VIDEO_SECONDS=600
RECORDING_RETENTION_DAYS=90
EXPORT_RETENTION_DAYS=30
LIVE_EVENT_FRESHNESS_MS=10000
# Development only: allow private-network destinations such as the local RTMP sink (comma-separated host:port)
DEV_DESTINATION_ALLOWLIST=127.0.0.1:1936
RTMP_SINK_PASSWORD=__GENERATE__

# --- Optional integrations (each feature stays off until its keys are set) ---
# Social sign-in: each button appears once its id and secret are set. Redirect URL for each provider:
#   <PUBLIC_API_URL>/api/auth/callback/google  (…/apple, …/microsoft, …/facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, and a client secret JWT signed with the Sign in with Apple key (renew within 6 months)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Text-message sign-in codes: twilio (production) or mail (development: texts land in Mailpit). Unset: off.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# a Twilio number (+61…) or a Messaging Service SID (MG…)
TWILIO_FROM=
# Passkeys: the site's registrable domain (defaults to PUBLIC_WEB_URL's host name)
PASSKEY_RP_ID=
# Web push for reminders: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Card billing through Stripe (two recurring prices; webhook → /api/v1/webhooks/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLUB=
STRIPE_PRICE_LEAGUE=
# Scheduled pg_dump to the media bucket under backups/
BACKUP_ENABLED=false
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
# Monitoring: bearer token for GET /metrics; webhook for unhandled API errors
METRICS_TOKEN=
ERROR_REPORT_URL=
