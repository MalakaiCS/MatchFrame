{
  "name": "broadcast-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @bs/db generate",
    "db:migrate": "pnpm --filter @bs/db migrate",
    "db:seed": "pnpm --filter @bs/db seed",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "pnpm --filter @bs/e2e test",
    "test:media": "node tests/media/run-media-smoke.mjs",
    "record:reel": "node tests/e2e/record-reel.mjs",
    "demo:start": "node scripts/demo.mjs start",
    "demo:stop": "node scripts/demo.mjs stop",
    "services:up": "docker compose -f infra/docker-compose.yml --env-file .env --profile streaming up -d",
    "services:up:core": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "services:down": "docker compose -f infra/docker-compose.yml --env-file .env --profile streaming --profile media-test down",
    "start:hosted": "node scripts/start-hosted.mjs",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "@bs/config": "workspace:*",
    "@bs/db": "workspace:*",
    "@bs/services": "workspace:*",
    "@bs/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "esbuild": "0.28.2",
    "globals": "16.4.0"
  }
}
